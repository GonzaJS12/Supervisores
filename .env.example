# Neon (PostgreSQL)
#
# DATABASE_URL: connection pooling (runtime)
#   Dashboard Neon → Connection string → Pooled
#   Agregar sslmode=require y pgbouncer=true
#
# DIRECT_URL: unpooled (migraciones Prisma)
#   Dashboard Neon → Connection string → Direct
#   Agregar sslmode=require
#
# En local, ambas pueden ser la misma URL de PostgreSQL.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT (obligatorio, valor largo y aleatorio)
JWT_SECRET=

# CORS abierto de forma temporal en el código.
# Cuando el frontend esté en Vercel se puede restringir.
CORS_ORIGIN=http://localhost:5173

# Render (y otros PaaS) inyectan PORT. En local:
PORT=3000

NODE_ENV=development

# Solo para prisma seed (opcional)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
