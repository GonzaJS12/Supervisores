# Copiá este archivo a .env y completá los valores.
# cp .env.example .env   (o copy .env.example .env en Windows)

# --- Obligatorias para la API (load-env) ---

# Cadena de conexión de PostgreSQL. La usan Prisma, la API y el import territorial.
# En esta máquina el puerto suele ser 5433 (no 5432).
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5433/supervisores?schema=public"

# Secreto para firmar los JWT. Usá un valor largo y aleatorio; no lo commitees.
JWT_SECRET="change-me-to-a-long-random-string"

# --- Opcionales (tienen default en código) ---

# Expiración del access token (formato ms/jsonwebtoken: 8h, 1d, 3600, ...). Default: 8h
JWT_EXPIRES_IN="8h"

# Origen(es) CORS. Uno, o varios separados por coma. Default: http://localhost:5173
CORS_ORIGIN="http://localhost:5173"

# Tope de GET /supervisiones/exportacion. Default: 500. Si se supera → HTTP 400
SUPERVISIONES_EXPORT_MAX="500"

# --- Seed (npx prisma db seed) ---

# Email del administrador inicial. Default: admin@supervision.local
SEED_ADMIN_EMAIL="admin@supervision.local"

# Obligatoria para el seed. No hay contraseña por defecto.
# Re-ejecutar el seed actualiza el passwordHash del admin con este valor.
SEED_ADMIN_PASSWORD=""
