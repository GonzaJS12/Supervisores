# PostgreSQL connection string used by Prisma and the Nest process.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/supervisores?schema=public"

# HMAC secret for JWT signing. Use a long random value. No default.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional. Used only by prisma/seed.ts. Defaults to admin@supervision.local.
SEED_ADMIN_EMAIL="admin@supervision.local"

# Required to run the seed. There is no password fallback in source.
SEED_ADMIN_PASSWORD="change-me"
