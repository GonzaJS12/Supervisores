# Cadena de conexión de PostgreSQL. La usan Prisma, la API y el import territorial.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/supervisores?schema=public"

# Secreto para firmar los JWT. Usá un valor largo y aleatorio; no lo commitees.
JWT_SECRET="change-me"

# Opcional. Si no se define, el seed usa admin@supervision.local.
SEED_ADMIN_EMAIL="admin@supervision.local"

# Obligatoria para `npx prisma db seed`. No hay contraseña por defecto.
SEED_ADMIN_PASSWORD=""
